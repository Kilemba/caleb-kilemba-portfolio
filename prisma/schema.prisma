generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum MessageStatus {
  UNREAD
  READ
  REPLIED
  ARCHIVED
}

model AdminUser {
  id           String         @id @default(cuid())
  email        String         @unique
  passwordHash String
  name         String         @default("Caleb Kilemba")
  sessions     AdminSession[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model AdminSession {
  id          String    @id @default(cuid())
  tokenHash   String    @unique
  adminUserId String
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
  @@index([expiresAt])
}

model Technology {
  id       String    @id @default(cuid())
  name     String    @unique
  slug     String    @unique
  projects Project[]
  services Service[]
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

model Project {
  id              String       @id @default(cuid())
  title           String
  slug            String       @unique
  category        String
  summary         String
  businessProblem String
  solution        String
  businessImpact  String
  impactMetric    String?
  architecture    String
  caseStudy       String
  coverImage      String?
  githubUrl       String?
  liveUrl         String?
  featured        Boolean      @default(false)
  published       Boolean      @default(false)
  sortOrder       Int          @default(0)
  technologies    Technology[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([published, sortOrder])
  @@index([featured])
}

model Service {
  id           String       @id @default(cuid())
  title        String
  slug         String       @unique
  description  String
  published    Boolean      @default(true)
  sortOrder    Int          @default(0)
  technologies Technology[]
  bookings     Booking[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([published, sortOrder])
}

model Tag {
  id        String     @id @default(cuid())
  name      String     @unique
  slug      String     @unique
  blogPosts BlogPost[]
  createdAt DateTime   @default(now())
}

model BlogPost {
  id           String    @id @default(cuid())
  title        String
  slug         String    @unique
  excerpt      String
  content      String    @default("")
  coverImage   String?
  category     String
  published    Boolean   @default(false)
  featured     Boolean   @default(false)
  publishedAt  DateTime?
  devToUrl     String?
  canonicalUrl String?
  tags         Tag[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([published, publishedAt])
  @@index([featured])
}

model Booking {
  id                 String        @id @default(cuid())
  name               String
  email              String
  company            String
  projectDescription String
  bookingDate        DateTime      @db.Date
  startTime          String
  activeSlotKey      String?       @unique
  status             BookingStatus @default(PENDING)
  serviceId          String
  service            Service       @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([bookingDate, startTime])
  @@index([status, createdAt])
}

model Availability {
  id           String   @id @default(cuid())
  dayOfWeek    Int      @unique
  startTime    String
  endTime      String
  slotDuration Int      @default(60)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model BlockedDate {
  id        String   @id @default(cuid())
  date      DateTime @unique @db.Date
  reason    String?
  createdAt DateTime @default(now())
}

model ContactMessage {
  id        String        @id @default(cuid())
  name      String
  email     String
  company   String
  phone     String?
  subject   String
  message   String
  status    MessageStatus @default(UNREAD)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status, createdAt])
}

model Testimonial {
  id          String   @id @default(cuid())
  name        String
  company     String
  role        String
  testimonial String
  published   Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published, sortOrder])
}

model SiteSettings {
  id                  String   @id @default("default")
  name                String   @default("Caleb Kilemba")
  professionalTitle   String   @default("Data Engineer • Analytics Engineer • Consultant")
  heroHeading         String   @default("I build data solutions that solve real business problems.")
  homepageIntroduction String
  aboutText           String
  linkedinUrl         String?
  githubUrl           String?
  email               String?
  phone               String?
  location            String?
  resumeUrl           String?
  seoDescription      String
  bookingIntroduction String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

/// Single uploaded CV, stored in the database because Vercel's filesystem is read-only
/// and ephemeral. A PDF is small enough that this avoids depending on an object store.
model ResumeFile {
  id          String   @id @default("default")
  filename    String
  contentType String
  size        Int
  data        Bytes
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Career history shown on the About page and editable at /admin/experience.
model Experience {
  id         String    @id @default(cuid())
  role       String
  company    String
  location   String?
  startDate  DateTime
  /// Null while this is the current role.
  endDate    DateTime?
  summary    String?
  /// One achievement per entry, rendered as bullets.
  highlights String[]
  sortOrder  Int       @default(0)
  published  Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

/// Binary assets uploaded through the admin panel, keyed by purpose (e.g. "profile-photo").
/// Stored in the database because Vercel's filesystem is read-only and ephemeral, so an
/// uploaded file would not survive the next deploy.
model MediaAsset {
  id          String   @id
  filename    String
  contentType String
  size        Int
  data        Bytes
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
