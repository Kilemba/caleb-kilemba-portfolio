# PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/caleb_portfolio?schema=public"

# Public site URL. No trailing slash.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Session settings
SESSION_COOKIE_NAME="caleb_admin_session"
SESSION_DAYS="7"

# Optional: seed/create the first admin automatically.
# For production, prefer: npm run create-admin -- your@email.com "StrongPasswordHere"
ADMIN_EMAIL="caleb@example.com"
ADMIN_PASSWORD="ChangeMeImmediately123!"

# Image storage: local or s3
IMAGE_STORAGE_MODE="local"

# S3-compatible storage (required only when IMAGE_STORAGE_MODE=s3)
S3_REGION="auto"
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""
S3_FORCE_PATH_STYLE="false"
